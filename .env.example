# Nemotron Unified Container - Environment Configuration
#
# This file documents all available configuration options for docker-compose.yaml.
# Copy this file to .env and customize for your setup.
#
# Quick start: Use one of the pre-configured templates:
#   cp .env.llamacpp-q8.example .env    # Most common: Q8 quantization
#   cp .env.llamacpp-q4.example .env    # For 32GB GPUs
#   cp .env.vllm.example .env           # For cloud/multi-GPU deployment
#   cp .env.no-llm.example .env         # ASR + TTS only (no LLM)

# ==============================================================================
# Profile Selection (REQUIRED)
# ==============================================================================
# Determines which service variant to use and network mode
#
# Options:
#   llamacpp  - For llamacpp-q8 or llamacpp-q4 modes
#               Uses bridge network with port mapping (8080, 8001, 8000)
#   vllm      - For vLLM BF16 mode
#               Uses host network (DNS workaround for HuggingFace)
#
# IMPORTANT: Must match your LLM_MODE setting below
COMPOSE_PROFILES=llamacpp

# ==============================================================================
# Container Configuration
# ==============================================================================
# Docker image name (built with Dockerfile.unified)
#
# Image naming convention: nemotron-unified:<gpu-arch>
#   cuda13        - Default, works on most GPUs with CUDA 13.0+
#   blackwell     - For DGX Spark, RTX 5090 (sm_120/121)
#   ampere        - For A100, A10, A30, A40, RTX 30xx (sm_80/86)
#
# Build command:
#   docker build -f Dockerfile.unified -t nemotron-unified:cuda13 .
#   docker build -f Dockerfile.unified --build-arg GPU_ARCH=ampere -t nemotron-unified:ampere .
NEMOTRON_IMAGE=nemotron-unified:cuda13

# Project name for container naming (default: nemotron)
# Container will be named: <PROJECT_NAME>-llamacpp or <PROJECT_NAME>-vllm
PROJECT_NAME=nemotron

# GPU architecture (should match image build target)
# Used for runtime detection and optimization
GPU_ARCH=blackwell

# ==============================================================================
# Service Control
# ==============================================================================
# Enable/disable individual services
# Set to false to disable a service (e.g., ENABLE_LLM=false for ASR+TTS only)
ENABLE_ASR=true
ENABLE_TTS=true
ENABLE_LLM=true

# ==============================================================================
# LLM Configuration (REQUIRED if ENABLE_LLM=true)
# ==============================================================================
# LLM mode determines which inference engine to use
#
# Options:
#   llamacpp-q8  - llama.cpp with Q8_0 quantization (~32GB VRAM)
#                  Best quality/VRAM balance, recommended for DGX Spark
#   llamacpp-q4  - llama.cpp with Q4_0 quantization (~16GB VRAM)
#                  Optimized for 32GB GPUs (e.g., RTX 5090)
#   vllm         - vLLM with BF16 precision (~72GB VRAM)
#                  For cloud deployment or multi-GPU systems
#
# IMPORTANT: LLM_MODE must match COMPOSE_PROFILES
#   llamacpp-q8 or llamacpp-q4 → COMPOSE_PROFILES=llamacpp
#   vllm → COMPOSE_PROFILES=vllm
LLM_MODE=llamacpp-q8

# --- llama.cpp Configuration (for llamacpp-q8 or llamacpp-q4) ---

# Path to GGUF model file INSIDE the container
#
# CRITICAL: This must be a CONTAINER path, not a host path
#
# For HuggingFace cache models (most common):
#   Container path: /root/.cache/huggingface/hub/models--<org>--<model>/snapshots/<hash>/<file>.gguf
#   Host path:      ~/.cache/huggingface/hub/models--<org>--<model>/snapshots/<hash>/<file>.gguf
#
#   Example:
#     Host:      /home/user/.cache/huggingface/hub/models--unsloth--Nemotron-3-Nano-30B-A3B-GGUF/snapshots/abc123/Q8_0.gguf
#     Container: /root/.cache/huggingface/hub/models--unsloth--Nemotron-3-Nano-30B-A3B-GGUF/snapshots/abc123/Q8_0.gguf
#
# For external models (outside HF cache):
#   Container path: /models/<filename>.gguf
#   Also set MODEL_DIR below to your host model directory
#
#   Example:
#     Host:      /home/user/my-models/Q8_0.gguf
#     MODEL_DIR: /home/user/my-models
#     Container: /models/Q8_0.gguf
#
# Download models:
#   huggingface-cli download unsloth/Nemotron-3-Nano-30B-A3B-GGUF
LLAMA_MODEL=/root/.cache/huggingface/hub/models--unsloth--Nemotron-3-Nano-30B-A3B-GGUF/snapshots/REPLACE-WITH-HASH/Q8_0.gguf

# Number of parallel slots (1 = single slot for 100% KV cache reuse)
# IMPORTANT: Do not change unless you understand the implications
# Single-slot operation ensures near-zero latency on subsequent turns
LLAMA_PARALLEL=1

# Context size (number of tokens)
# 16384 is sufficient for multi-turn conversations with buffered LLM
LLAMA_CTX_SIZE=16384

# Reasoning budget for Q4 mode (thinking/scratchpad tokens)
# 0 = disabled (recommended), -1 = unlimited
# Only affects Q4 mode, ignored for Q8
LLAMA_REASONING_BUDGET=0

# --- vLLM Configuration (for LLM_MODE=vllm) ---

# HuggingFace model ID or local path
# For Nemotron-3-Nano: nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-BF16
#
# Download:
#   huggingface-cli download nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-BF16
VLLM_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-BF16

# GPU memory utilization (0.0-1.0, recommended: 0.60)
# Fraction of GPU memory to allocate for vLLM
# Lower if you get OOM errors
VLLM_GPU_MEMORY_UTILIZATION=0.60

# ==============================================================================
# Volume Mounts
# ==============================================================================
# Project directory (maps to /workspace in container)
# Contains scripts, bots, source code
# Use . for current directory (relative path)
PROJECT_DIR=.

# HuggingFace model cache (maps to /root/.cache/huggingface in container)
# Models are auto-downloaded here on first run
# Use absolute path or ~ for home directory
HF_CACHE_DIR=~/.cache/huggingface

# External model directory (maps to /models in container)
# Set this to your host directory containing model files
#
# Examples:
#   MODEL_DIR=/data/models              # Common setup
#   MODEL_DIR=/home/user/my-models      # User-specific path
#   MODEL_DIR=~/.cache/huggingface      # Same as HF cache (redundant)
#
# If using external models:
#   1. Set MODEL_DIR to your host directory containing .gguf files
#   2. Set LLAMA_MODEL to /models/<filename>.gguf (container path)
MODEL_DIR=/data/models

# ==============================================================================
# Service Ports (only used in llamacpp profile)
# ==============================================================================
# Host ports for service access
# vLLM profile uses host network, so these are ignored
ASR_PORT=8080
TTS_PORT=8001
LLM_PORT=8000

# ==============================================================================
# Service Timeouts
# ==============================================================================
# Seconds to wait for services to start up
#
# Timing guidance:
#   60   - Fast startup (models already cached locally)
#   300  - First run with model download (~5 minutes)
#   600  - Large model download (~10 minutes)
#   900  - vLLM mode (model load + compilation, ~15 minutes)
#
# The timeout is auto-extended during model downloads
SERVICE_TIMEOUT=60

# ==============================================================================
# HuggingFace Authentication (optional)
# ==============================================================================
# Required for gated models or private repositories
# Get token from: https://huggingface.co/settings/tokens
#
# Leave empty for public models
HUGGINGFACE_ACCESS_TOKEN=

# ==============================================================================
# Bot Configuration (for docker-compose.bot.yaml)
# ==============================================================================
# These settings configure the voice bot container

# Bot container image and name
BOT_IMAGE=nemotron-bot:latest
BOT_CONTAINER_NAME=nemotron-bot

# Port the bot listens on (used by tailscale serve)
BOT_PORT=7860

# AI service URLs (bot connects to these)
# Default values work when AI services run on same host
NVIDIA_ASR_URL=ws://localhost:8080
NVIDIA_TTS_URL=http://localhost:8001
NVIDIA_LLAMA_CPP_URL=http://localhost:8000

# Enable stereo audio recording (user left channel, bot right channel)
# Recordings saved to recordings/ directory
ENABLE_RECORDING=false

# Daily.co transport (optional, for cloud deployment)
# Get API key from https://dashboard.daily.co/developers
DAILY_API_KEY=
DAILY_ROOM_URL=

# ==============================================================================
# Advanced Configuration
# ==============================================================================
# PyTorch CUDA memory allocator configuration
# Prevents memory fragmentation on 32GB GPUs
#
# DO NOT CHANGE unless you know what you're doing
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
